<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="update_rules.json" />
    <Compile Remove="vendor/**/*.cs" />
    <Compile Include="vendor/vsix/DarkestData.cs" Link="LinkedSources\DarkestData.cs" />
    <Compile Include="vendor/BuffGrammarChecker.Core/*.cs" Link="LinkedSources\BuffCore\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
